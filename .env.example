# ==============================================================================
# 🎬 TikTok AI Video Generator & Auto-Poster - Environment Variables (.env)
# ==============================================================================
# Copy this file to '.env' before running:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI API KEYS (OPTIONAL / DYNAMIC STORY GENERATION)
# ------------------------------------------------------------------------------
# Google Gemini API Key:
# Used to generate unlimited fresh viral topics and story scripts dynamically.
# 👉 WHERE TO GET: Get your free API key at: https://aistudio.google.com/app/apikey
# 💡 NOTE: If left blank or commented out, the generator automatically uses the 
#          built-in database of 50+ curated high-retention stories without any API key!
GEMINI_API_KEY=your_gemini_api_key_here


# ------------------------------------------------------------------------------
# 2. VOICEOVER & TTS SETTINGS (EDGE-TTS NEURAL VOICES)
# ------------------------------------------------------------------------------
# Microsoft Edge-TTS High Quality Neural Voices (100% Free & No API key needed)
#
# Recommended English Voices:
#   - en-US-BrianNeural        (Deep, engaging American documentary narrator)
#   - en-US-ChristopherNeural  (Energetic storytelling)
#   - en-US-GuyNeural          (Casual, conversational)
#   - en-US-EricNeural         (Authoritative, news-style)
DEFAULT_VOICE_EN=en-US-BrianNeural

# Recommended Polish Voices:
#   - pl-PL-MarekNeural        (Clear, dynamic Polish male narrator)
#   - pl-PL-ZofiaNeural        (Natural Polish female voice)
DEFAULT_VOICE_PL=pl-PL-MarekNeural


# ------------------------------------------------------------------------------
# 3. ANTI-SHADOWBAN & VIDEO ENCODING SETTINGS
# ------------------------------------------------------------------------------
# Adds subtle 2% film grain to bypass frame hash duplication algorithms:
APPLY_FILM_GRAIN=true
GRAIN_INTENSITY=2

# Injects mobile Apple iPhone metadata to simulate recording on a real smartphone:
SPOOF_DEVICE_METADATA=true
SPOOFED_MAKE=Apple
SPOOFED_MODEL=iPhone 15 Pro

# Automatically toggles the "AI-generated content" disclosure in TikTok Studio:
# Set to 'false' if you want regular organic publishing, or 'true' to disclose:
DECLARE_AI_CONTENT=false


# ------------------------------------------------------------------------------
# 4. STORAGE & BROWSER SESSION PATHS
# ------------------------------------------------------------------------------
# Local path where Playwright stores your TikTok login cookies and session:
TIKTOK_SESSION_DIR=~/.tiktok_automation_session


# ------------------------------------------------------------------------------
# 5. DAILY PUBLICATION SCHEDULE (EASY FREQUENCY CONTROL)
# ------------------------------------------------------------------------------
# How many videos to publish per day (e.g. 1, 2, 3, 4, 6, 8, 10):
# The system automatically calculates optimal spaced slots across the day!
# Examples:
#   POSTS_PER_DAY=4  -> posts at 09:00, 13:00, 17:00, 21:00
#   POSTS_PER_DAY=6  -> posts at 08:30, 11:00, 13:30, 16:00, 18:30, 21:00
#   POSTS_PER_DAY=10 -> posts at 08:30, 10:00, 11:30, 13:00, 14:30, 16:00, 17:30, 19:00, 20:30, 22:00
POSTS_PER_DAY=4

# OR specify exact custom publication times (comma-separated, 24h format):
# SCHEDULE_TIMES=09:00,13:00,17:00,21:00
