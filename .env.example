# ==========================================
# TikTok AI Video Generator & Auto-Poster
# Configuration File (.env)
# ==========================================

# 1. Gemini AI API Key (Optional - generator works out of the box with 50+ curated viral stories)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Voiceover configuration (Edge-TTS high-quality neural voices)
# English options: en-US-ChristopherNeural, en-US-GuyNeural, en-US-EricNeural, en-US-BrianNeural
DEFAULT_VOICE_EN=en-US-BrianNeural
# Polish options: pl-PL-MarekNeural, pl-PL-ZofiaNeural
DEFAULT_VOICE_PL=pl-PL-MarekNeural

# 3. Video Anti-Fingerprinting & Quality
APPLY_FILM_GRAIN=true
GRAIN_INTENSITY=2
SPOOF_DEVICE_METADATA=true
SPOOFED_MAKE=Apple
SPOOFED_MODEL=iPhone 15 Pro
DECLARE_AI_CONTENT=false

# 4. Storage & Session Path
TIKTOK_SESSION_DIR=~/.tiktok_automation_session
